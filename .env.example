# Copy this file to .env and fill in your own values.
# Get these from https://dashboard.stripe.com/test/apikeys (make sure you're in TEST MODE)

STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Get this by running `stripe listen --forward-to localhost:3000/webhooks/stripe`
# The CLI prints a webhook signing secret starting with whsec_
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# A test-mode Price ID for the product you want to sell.
# Create one at https://dashboard.stripe.com/test/products
STRIPE_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx

# Where Stripe should redirect the customer after checkout
CLIENT_SUCCESS_URL=http://localhost:3000/success
CLIENT_CANCEL_URL=http://localhost:3000/cancel

MONGO_URI=mongodb://localhost:27017/stripe_billing_backend

PORT=3000
